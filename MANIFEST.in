include LICENSE NOTICE README.md README.cs.md CITATION.cff THIRD_PARTY_NOTICES.md
include models.example.toml models.torch.example.toml experiment-zahrada12-materials.json
recursive-include docs *.md
recursive-include tools *.py
recursive-include apertus/garden/static *.html *.js *.css
include apertus/garden/*.toml
include apertus/garden/*protocol.json
include apertus/garden/model_comparison_examples.json
prune apertus/garden/e2e/node_modules
prune apertus/garden/desktop/node_modules
prune apertus/garden/e2e/test-results
prune apertus/garden/e2e/playwright-report
prune apertus/garden/e2e/.e2e-data
prune apertus/garden/desktop/dist
global-exclude __pycache__ *.py[cod] .DS_Store
